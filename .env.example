# Local-first development defaults. Copy this file to `.env` to run the full
# application without any external accounts.

# Use the built-in demo sign-in and the local JSON data store.
LOCAL_AUTH=true
LOCAL_DATA=true
VITE_LOCAL_AUTH=true

# Signing secret for local sessions. Replace it for any shared or deployed use.
JWT_SECRET=english-career-coach-local-development-secret

# Optional: use a real OpenAI-compatible chat provider instead of the offline
# rule-based coach. Any endpoint that supports /chat/completions works.
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-key
# LLM_MODEL=gpt-4o-mini

# Optional: use MySQL instead of the local JSON store.
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/english_career_coach

# Optional: change where local data is saved.
# LOCAL_DATA_FILE=.data/local-db.json
